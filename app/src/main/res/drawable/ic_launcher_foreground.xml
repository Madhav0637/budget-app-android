<?xml version="1.0" encoding="utf-8"?>
<!--
    The Koku mark: a mint circle, an amber pill and a periwinkle pill, drawn on the same 512 grid as the iOS icon
    (see KokuLogo in ui/components). The group scales the shapes to about 41dp and centres them in the 108dp layer,
    well inside the 66dp safe zone that every launcher mask keeps.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.16"
        android:scaleY="0.16"
        android:translateX="13.84"
        android:translateY="16.4">
        <path
            android:fillColor="#34D399"
            android:pathData="M122,194A72,72 0,1 1,266 194A72,72 0,1 1,122 194Z" />
        <path
            android:fillColor="#FBBF24"
            android:pathData="M163,266H225A41,41 0,0 1,225 348H163A41,41 0,0 1,163 266Z" />
        <path
            android:fillColor="#818CF8"
            android:pathData="M266,220A57,57 0,0 1,380 220V291A57,57 0,0 1,266 291Z" />
    </group>
</vector>
